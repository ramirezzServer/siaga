# Salin lewat `make env` (password acak dibuat otomatis). Jangan commit file .env.
COMPOSE_PROJECT_NAME=siaga

POSTGRES_DB=siaga
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ganti-saya
POSTGRES_PORT=5432

SIAGA_GEO_PASSWORD=ganti-saya
SIAGA_CORE_PASSWORD=ganti-saya
SIAGA_ALERT_PASSWORD=ganti-saya
SIAGA_AI_PASSWORD=ganti-saya
SIAGA_TILES_PASSWORD=ganti-saya

NATS_URL=nats://127.0.0.1:4222

# Garage (object storage S3, ADR 0014). Bucket dan access key dibuat Garage
# saat start dari nilai di bawah. Arsip ingest: s3://<bucket>/raw.
GARAGE_RPC_SECRET=ganti-saya-hex32
GARAGE_ADMIN_TOKEN=ganti-saya
GARAGE_METRICS_TOKEN=ganti-saya
GARAGE_S3_PORT=3900
ARCHIVE_BUCKET=siaga-arsip
ARCHIVE_S3_ACCESS_KEY_ID=ganti-saya-gk
ARCHIVE_S3_SECRET_ACCESS_KEY=ganti-saya-hex32

# Ambang deduplikasi gempa, format <selisih waktu>,<jarak km>,<selisih magnitudo>.
# Kosong = bawaan hasil kalibrasi (ADR 0008).
# QUAKE_DEDUP_CROSS_SOURCE=30s,100,1.0
# QUAKE_DEDUP_REVISION=10s,50,1.0

# Open-Meteo tanpa key (non-komersial). Isi provinsi dengan "," untuk mematikan ketiga konektornya.
# INGEST_OPENMETEO_PROVINCES=32
# OPENMETEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast

# Key gratis (daftar dengan email). Kosong = konektor OpenAQ atau FIRMS tidak dijalankan.
# OpenAQ: https://explore.openaq.org (API key di halaman akun), dikirim lewat header X-API-Key.
# FIRMS:  https://firms.modaps.eosdis.nasa.gov/api/map_key/
OPENAQ_API_KEY=
FIRMS_MAP_KEY=
# Kotak wilayah barat,selatan,timur,utara. Bawaan menutup Jawa Barat.
# INGEST_OPENAQ_BBOX=106.3,-7.9,108.9,-5.7
# INGEST_FIRMS_BBOX=106.3,-7.9,108.9,-5.7

LOG_LEVEL=info
